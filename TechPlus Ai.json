    {
      "parameters": {
        "promptType": "define",
        "text": "You are the second-stage AI reviewer for my daily IT intelligence system.\n\nReview the output generated by the first AI.\n\nYour tasks:\n1. Remove duplicate or repetitive news.\n2. Identify information that appears unreliable or unclear.\n3. Keep only genuinely useful IT updates.\n4. Prioritize:\n   - AI and AI agents\n   - New AI tools and model releases\n   - Cybersecurity\n   - Cloud computing\n   - Microsoft, Google, AWS and other major technology companies\n   - New courses, certifications and learning opportunities\n   - Important changes to existing AI tools\n   - Major developer and software updates\n5. Keep important links when available.\n6. Do not invent or assume information that is not present in the input.\n\nReturn a clean list of the most important updates.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
